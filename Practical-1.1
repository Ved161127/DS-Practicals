#include <iostream>
using namespace std;

int main() {
    int arr[100], n, i, element, pos;

    cout << "Enter the number of elements: ";
    cin >> n;

    cout << "Enter " << n << " elements:\n";
    for (i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "\nArray elements are: ";
    for (i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    cout << "\nEnter the element to insert: ";
    cin >> element;
    cout << "Enter the position (1 to " << n + 1 << "): ";
    cin >> pos;

    if (pos >= 1 && pos <= n + 1) {
        for (i = n; i >= pos; i--) {
            arr[i] = arr[i - 1];
        }
        arr[pos - 1] = element;
        n++;

        cout << "Array after insertion: ";
        for (i = 0; i < n; i++) {
            cout << arr[i] << " ";
        }
    } else {
        cout << "Invalid position!";
    }

    cout << "\nEnter the position to delete (1 to " << n << "): ";
    cin >> pos;

    if (pos >= 1 && pos <= n) {
        for (i = pos - 1; i < n - 1; i++) {
            arr[i] = arr[i + 1];
        }
        n--;

        cout << "Array after deletion: ";
        for (i = 0; i < n; i++) {
            cout << arr[i] << " ";
        }
    } else {
        cout << "Invalid position!";
    }

    cout << "\nEnter the element to search: ";
    cin >> element;

    bool found = false;
    for (i = 0; i < n; i++) {
        if (arr[i] == element) {
            cout << "Element found at position " << i + 1 << endl;
            found = true;
            break;
        }
    }

    if (!found) {
        cout << "Element not found." << endl;
    }

    return 0;
}
